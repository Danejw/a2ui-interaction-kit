{
  "name": "@danejw/a2ui-interaction-kit",
  "version": "0.3.0",
  "private": false,
  "description": "Composable interactions for agent-generated A2UI interfaces",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danejw/a2ui-interaction-kit.git"
  },
  "keywords": [
    "a2ui",
    "agent-ui",
    "react",
    "interaction",
    "gestures"
  ],
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/react/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./a2ui/react": {
      "types": "./dist/a2ui/react.d.ts",
      "import": "./dist/a2ui/react.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./catalog.json": "./catalog/catalog.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-catalog.mjs",
    "prepare": "npm run build",
    "dev:lab": "npm run dev --workspace @danejw/interaction-lab -- --host 127.0.0.1",
    "build:lab": "npm run build && npm run build --workspace @danejw/interaction-lab",
    "typecheck:lab": "npm run typecheck --workspace @danejw/interaction-lab",
    "test:lab": "node --experimental-strip-types --test apps/playground/tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:lab": "npm run test:lab && npm run build:lab && npm run typecheck:lab"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "@a2ui/react": "*",
    "@a2ui/web_core": "*",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@a2ui/react": {
      "optional": true
    },
    "@a2ui/web_core": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2ui/react": "*",
    "@a2ui/web_core": "*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.10.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
