{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Danejw/a2ui-interaction-kit/blob/main/catalog/catalog.json",
  "catalogId": "https://github.com/Danejw/a2ui-interaction-kit/blob/main/catalog/catalog.json",
  "protocolVersion": "1.0",
  "title": "A2UI Interaction Kit",
  "description": "Adds semantic, reusable interactions to agent-generated interfaces.",
  "instructions": "Use InteractiveItem for tasks, approvals, notices, incidents and reports. Pick a contextual variant, status, metadata and primary actionLabel. Declare capabilities only when the host supports them and bind actions to registered handlers. Keep secondary actions in accessible menus and always provide semantic buttons alongside gestures. The host owns authorization and mutation acknowledgement. Never assume dismiss deletes underlying data.",
  "components": {
    "InteractiveItem": {
      "type": "object",
      "description": "Interactive task, notification, approval, incident or report with contextual primary action, menu, touch gestures, selection, priority and details.",
      "properties": {
        "component": {
          "const": "InteractiveItem"
        },
        "itemId": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "actionLabel": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "expandable",
              "dismissible",
              "prioritizable",
              "selectable",
              "actionable"
            ]
          }
        },
        "prioritized": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "onDismiss": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onPrioritize": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onSelect": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onActivate": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onExpand": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "variant": {
          "type": "string",
          "enum": [
            "task",
            "approval",
            "notice",
            "incident",
            "report"
          ]
        },
        "status": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "metadata": {
          "$ref": "common_types.json#/$defs/DynamicString"
        }
      },
      "required": [
        "component",
        "itemId",
        "title",
        "capabilities"
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/InteractiveItem"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "not": {}
    }
  }
}
