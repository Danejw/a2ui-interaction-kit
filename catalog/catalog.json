{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Danejw/a2ui-interaction-kit/blob/main/catalog/catalog.json",
  "catalogId": "https://github.com/Danejw/a2ui-interaction-kit/blob/main/catalog/catalog.json",
  "protocolVersion": "1.0",
  "title": "A2UI Interaction Kit",
  "description": "Adds semantic, reusable interactions to agent-generated interfaces.",
  "instructions": "Use InteractiveItem for tasks, approvals, notices, incidents and reports. Pick a contextual variant, status, metaLabel and primary actionLabel. Declare capabilities only when the host supports them and bind actions to registered handlers. Keep secondary actions in accessible menus and always provide semantic buttons alongside gestures. The host owns authorization and mutation acknowledgement. Never assume dismiss deletes underlying data. InteractiveDataTable supports read-only data exploration through local sorting, searching, selection and row expansion; it never implies a backend mutation. feedbackPhase and feedbackMessage must reflect host-acknowledged pending, success or error state. Gesture dispatch alone cannot confirm success. Motion uses reduced-motion fallback and semantic controls remain available.",
  "components": {
    "InteractiveItem": {
      "type": "object",
      "description": "Interactive task, notification, approval, incident or report with contextual primary action, menu, touch gestures, selection, priority and details.",
      "properties": {
        "component": {
          "const": "InteractiveItem"
        },
        "itemId": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "actionLabel": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "expandable",
              "dismissible",
              "prioritizable",
              "selectable",
              "actionable"
            ]
          }
        },
        "prioritized": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "children": {
          "$ref": "common_types.json#/$defs/ChildList"
        },
        "onDismiss": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onPrioritize": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onSelect": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onActivate": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "onExpand": {
          "$ref": "common_types.json#/$defs/Action"
        },
        "variant": {
          "type": "string",
          "enum": [
            "task",
            "approval",
            "notice",
            "incident",
            "report"
          ]
        },
        "status": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "metaLabel": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "feedbackPhase": {
          "type": "string",
          "enum": [
            "idle",
            "pending",
            "success",
            "error"
          ]
        },
        "feedbackMessage": {
          "$ref": "common_types.json#/$defs/DynamicString"
        }
      },
      "required": [
        "component",
        "itemId",
        "title",
        "capabilities"
      ],
      "unevaluatedProperties": false
    },
    "InteractiveDataTable": {
      "type": "object",
      "description": "Data table with local search, sorting, row selection and expandable row details. Local interactions do not mutate backend state.",
      "properties": {
        "component": {
          "const": "InteractiveDataTable"
        },
        "title": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "description": {
          "$ref": "common_types.json#/$defs/DynamicString"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "values"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "component",
        "title",
        "columns",
        "rows"
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/InteractiveItem"
        },
        {
          "$ref": "#/components/InteractiveDataTable"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "not": {}
    }
  }
}
